{
  "name": "spatialdb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "test": "./scripts/db.sh testdb >/dev/null && export DB_URL=\"$(./scripts/db.sh testurl)\" && tsx test/e2e.ts && tsx test/store.ts && tsx test/undo.ts && tsx test/canvas.ts && tsx test/stream.ts && tsx test/grid.ts && tsx test/assets.ts && tsx test/ui.ts && tsx test/sections.ts && tsx test/scope.ts && tsx test/auth.ts && tsx test/structured.ts && tsx test/kanban.ts && tsx test/prod.ts",
    "test:e2e": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/e2e.ts",
    "test:stream": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/stream.ts",
    "backup": "./scripts/backup.sh dump",
    "test:store": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/store.ts",
    "test:undo": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/undo.ts",
    "test:canvas": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/canvas.ts",
    "test:reads": "tsx test/reads.ts",
    "test:grid": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/grid.ts",
    "test:ui": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/ui.ts",
    "test:assets": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/assets.ts",
    "test:sections": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/sections.ts",
    "test:scope": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/scope.ts",
    "test:auth": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/auth.ts",
    "user": "./scripts/user.sh",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test:prod": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/prod.ts",
    "migrate": "tsx src/server/migrateCli.ts",
    "test:structured": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/structured.ts",
    "test:kanban": "./scripts/db.sh testdb >/dev/null && DB_URL=\"$(./scripts/db.sh testurl)\" tsx test/kanban.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "hono": "^4.12.31",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
